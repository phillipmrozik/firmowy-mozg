    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// =========================================================\n// Tekst ze skanu (OCR) -> ten sam format co zwykły PDF\n// =========================================================\n\nconst poprzedni = $('Czy tekst OK?').item.json;                 // naklejka pliku\nconst surowy = $('OCR – pobierz tekst').item.json.tekst_ocr || ''; // tekst z OCR\n\nconst tekst = surowy\n  .replace(/^\\uFEFF/, '')      // niewidoczny znak na początku pliku (BOM)\n  .replace(/\\r/g, '')          // znaki końca linii z Windowsa\n  .replace(/[ \\t]+/g, ' ')     // kilka spacji -> jedna\n  .replace(/\\n{3,}/g, '\\n\\n')  // max jedna pusta linia odstępu\n  .trim();\n\nreturn {\n  json: {\n    ok: tekst.length >= 50,\n    tekst,\n    metadata: {\n      ...poprzedni.metadata,\n      chars: tekst.length,\n      ocr: true,\n    },\n  },\n};"
      },

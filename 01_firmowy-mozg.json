    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// =========================================================\n// Sprzątanie tekstu z PDF + naklejka z informacjami o pliku\n// =========================================================\n\nconst plik = $('Nowy plik w folderze').item.json;\nconst surowy = $json.text || '';\nconst liczbaStron = $json.numpages || 1;\n\n// 1. Usuwamy stopki/nagłówki.\n//    Cyfry zamieniamy na \"#\", żeby \"str. 1\" i \"str. 2\" liczyły się jako ta sama linia.\nconst linie = surowy.split('\\n').map(l => l.trim());\nconst licznik = {};\nfor (const l of linie) {\n  const wzor = l.replace(/\\d+/g, '#');\n  licznik[wzor] = (licznik[wzor] || 0) + 1;\n}\n\nconst toStopka = (l) =>\n  // reguła 1: długa linia powtarzająca się na każdej stronie\n  (liczbaStron > 1 &&\n    l.length > 20 &&\n    licznik[l.replace(/\\d+/g, '#')] >= liczbaStron) ||\n  // reguła 2: linia kończąca się numerem strony (str. 1 / strona 2 / page 3)\n  /(str\\.|strona|page)\\s*\\d+\\s*$/i.test(l);\n\nlet tekst = linie.filter(l => !toStopka(l)).join('\\n');\n\n// 2. Porządki\ntekst = tekst\n  .replace(/•\\s*\\n/g, '• ')    // kropka listy sama w linii -> doklejamy do tekstu\n  .replace(/[ \\t]+/g, ' ')     // kilka spacji -> jedna\n  .replace(/\\n{3,}/g, '\\n\\n')  // max jedna pusta linia odstępu\n  .trim();\n\n// 3. Kontrola jakości – za mało tekstu = pewnie skan albo pusty plik\nconst ok = tekst.length >= 50;\n\nreturn {\n  json: {\n    ok,\n    tekst,\n    metadata: {\n      file_id: plik.id,\n      file_name: plik.name,\n      source_url: plik.webViewLink,\n      pages: liczbaStron,\n      chars: tekst.length,\n      ingested_at: new Date().toISOString(),\n    },\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "id": "eb1b8415-b88a-421e-b970-0f0a8f427a77",
      "name": "Posprzątaj tekst"
